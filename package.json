{
  "name": "kinglet-site",
  "version": "0.3.0",
  "private": true,
  "description": "Docs and landing page for Kinglet — small. light. king.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-releases.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --threads=1",
    "format:check": "oxfmt --check . --threads=1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/starlight": "^0.43.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource/chakra-petch": "^5.1.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.3",
    "@oxlint/plugins": "1.94.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0"
  }
}
